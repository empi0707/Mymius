{
  "name": "@mymius/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Mymius - SSH terminal, dual-pane file manager and folder sync",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder"
  },
  "dependencies": {
    "@mymius/core": "workspace:*",
    "@mymius/folder-sync": "workspace:*",
    "@mymius/platform": "workspace:*",
    "@mymius/providers": "workspace:*",
    "@mymius/remote-edit": "workspace:*",
    "@mymius/vault": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "vite": "^8.3.1"
  }
}
