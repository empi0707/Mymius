{
  "name": "@mymius/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Mymius - SSH terminal, dual-pane file manager and folder sync",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
    "dist": "electron-vite build && electron-builder",
    "build:e2e": "electron-vite build --mode e2e",
    "e2e": "electron-vite build --mode e2e && vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@mymius/core": "workspace:*",
    "@mymius/drive-sync": "workspace:*",
    "@mymius/folder-sync": "workspace:*",
    "@mymius/platform": "workspace:*",
    "@mymius/providers": "workspace:*",
    "@mymius/remote-edit": "workspace:*",
    "@mymius/ssh": "workspace:*",
    "@mymius/transfer": "workspace:*",
    "@mymius/vault": "workspace:*",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "chokidar": "^5.0.0",
    "picomatch": "^4.0.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "playwright-core": "^1.63.0",
    "vite": "^8.3.1"
  }
}
